{
  // Cloudflare Workers Static Assets — Vite React SPA
  // Build: npm run build  →  ./dist
  // Deploy: npm run deploy
  "name": "mixtally",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    // Unknown paths get a genuine HTTP 404 with the prerendered noindex
    // 404.html (client-side routing only ever requests real asset files).
    "not_found_handling": "404-page"
  }
}
